# ============================================================
# LawMate 환경변수 예시
# 실제 .env 파일에 자신의 API 키를 채워 사용하세요.
# ============================================================

# 법제처 API 키 (https://open.law.go.kr 에서 발급)
LAW_API_KEY=your_law_api_key_here

# 국회도서관 API 키 (https://open.nanet.go.kr 에서 발급)
NANET_API_KEY=your_nanet_api_key_here

# (선택) 진단 로그 활성화: 1 로 설정 시 [DEBUG] 로그 출력
# LAWMATE_DEBUG=0
